<!DOCTYPE CrossStudio_Project_File>
<solution Name="Nuvoton_M467" target="8" version="2">
  <project Name="Nuvoton_M467">
    <configuration
      Name="Common"
      combine_command="$(StudioDir)/bin/mkpkg -exclude ./Convert.sh -exclude ./Extract.sh -exclude ./Nuvoton_M467.hzp -exclude ./Nuvoton_M467.hzs -exclude ./Nuvoton_M467.hzq -exclude ./README.md -exclude ./examples -exclude ./.gitignore -exclude ./LICENSE -c &quot;$(CombiningOutputFilePath)&quot; ."
      combine_output_filepath="$(ProjectDir)/Nuvoton_M467.hzq"
      project_directory=""
      project_type="Combining" />
    <folder
      Name="packages"
      exclude=""
      filter=""
      path="packages"
      recurse="Yes" />
    <folder
      Name="targets"
      exclude=";targets/M4xx/Source/M4xx_Startup.s"
      filter=""
      path="targets"
      recurse="Yes" />
  </project>
</solution>
